GROQ_API_KEY=
GROQ_ROUTER_MODEL=openai/gpt-oss-120b
STT_PRIMARY=moulsot          # moulsot | groq
MOULSOT_ENDPOINT=            # hosted MoulSot Space URL, or isolated local JSON service endpoint
MOULSOT_PROTOCOL=            # optional json | gradio; blank uses the domain configuration
HF_TOKEN=                   # Hugging Face Read token for authenticated ZeroGPU requests
DEMO_TTS_PROVIDER=darija_xtts # darija_xtts | azure | groq | elevenlabs
AZURE_SPEECH_KEY=            # key from your Azure Speech resource
AZURE_SPEECH_REGION=         # matching region ID, e.g. westeurope; not an endpoint URL
ELEVENLABS_API_KEY=          # speech generation key for the Moroccan voice
LOG_LEVEL=INFO
